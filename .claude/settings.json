{
  "model": "claude-opus-5-5",
  "permissions": {
    "deny": [
      "Edit(docs/golden/**)",
      "Edit(docs/srs.md)",
      "Edit(docs/test-cases.md)",
      "Edit(docs/use-cases.md)",
      "Edit(docs/implementation-plan.md)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
